{
  "permissions": {
    "allow": [
      "Bash(/Users/edufigueiredos/Projetos/Pessoais/Cerebro/bin/cerebro:*)",
      "Bash(~/Projetos/Pessoais/Cerebro/bin/cerebro:*)",
      "Edit(~/Projetos/Pessoais/Cerebro/**)",
      "Write(~/Projetos/Pessoais/Cerebro/**)"
    ],
    "ask": [
      "Edit(~/Projetos/Pessoais/Cerebro/bin/**)",
      "Write(~/Projetos/Pessoais/Cerebro/bin/**)",
      "Edit(~/Projetos/Pessoais/Cerebro/skills/**)",
      "Write(~/Projetos/Pessoais/Cerebro/skills/**)"
    ],
    "deny": [
      "Edit(~/Projetos/Pessoais/Cerebro/pendencias.md)",
      "Write(~/Projetos/Pessoais/Cerebro/pendencias.md)",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "mcp__ccd_session_mgmt__send_message"
    ],
    "additionalDirectories": [
      "/Users/edufigueiredos/Projetos/Pessoais/Cerebro"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/edufigueiredos/Projetos/Pessoais/Cerebro/bin/hook inicio",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/edufigueiredos/Projetos/Pessoais/Cerebro/bin/hook guarda",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/edufigueiredos/Projetos/Pessoais/Cerebro/bin/hook novidade",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/edufigueiredos/Projetos/Pessoais/Cerebro/bin/hook registro",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
